{
  "name": "featurehub-openfeature-web-sdk",
  "version": "1.0.0",
  "description": "Official OpenFeature provider for FeatureHub (Web/browser). Streams the feature bundle and evaluates locally - no per-flag network calls.",
  "author": "info@featurehub.io",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "lib/index.js",
  "homepage": "https://featurehub.io",
  "repository": "github:featurehub-io/featurehub-javascript-sdk",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "keywords": [
    "feature-flag-api",
    "feature-flag-sdk",
    "feature-experimentation",
    "feature-flag",
    "flag",
    "toggle",
    "feature-toggle-api",
    "remote-configuration",
    "ab-testing",
    "openfeature",
    "openfeature-provider",
    "featurehub"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "rimraf node_modules dist",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepublishOnly": "cp ../../README.md . && pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@openfeature/web-sdk": ">=1.10.0 <2"
  },
  "dependencies": {
    "featurehub-javascript-client-sdk": "workspace:^"
  },
  "devDependencies": {
    "@openfeature/web-sdk": "^1.10.0",
    "featurehub-tsconfig": "workspace:*",
    "jsdom": "^27.1.0",
    "rimraf": "catalog:rimraf",
    "tsup": "catalog:tsup",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "vitest": "catalog:vitest"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
