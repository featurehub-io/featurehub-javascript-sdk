# Where the browser finds FeatureHub Edge, and a client-evaluated API key (it contains *).
# Put your own values in .env.local (not committed), which overrides these.
VITE_FEATUREHUB_EDGE_URL=http://localhost:8085
VITE_FEATUREHUB_API_KEY=
# How often to check FeatureHub for changes, in milliseconds
VITE_FEATUREHUB_POLL_INTERVAL=5000
# The todo backend (examples/todo-backend-openfeature)
VITE_TODO_SERVER_URL=http://localhost:8099
